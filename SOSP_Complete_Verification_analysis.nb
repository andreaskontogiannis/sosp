In[493]:=",ExpressionUUID->"fb415e8d-50be-a34c-b2c1-c73e6dc5b129"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"Group \"\>", "\[InvisibleSpace]", "\<\"E\"\>", 
