Notebook[{

Cell[CellGroupData[{
Cell["SOSP: verification following the proof", "Title",ExpressionUUID->"5eb3e363-a93a-6c4a-a593-90144b416a7a"],

Cell["\<\
Exact exclusion checks | Exhaustive cell patterns | Matching to \
representatives\
\>", "Subtitle",ExpressionUUID->"fbabc7df-73f6-a744-a487-9ac769db138e"],

Cell["\<\
This notebook supports the unified group analysis and classification in the \
paper. It uses the same corner data, rectangles, exclusion inequalities, and \
transformations. The classification first lists the patterns produced by the \
piecewise grid formulas, then checks the hypotheses of the group \
representatives. \
\>", "Text",
 CellChangeTimes->{{4.002182945252041*^9, 4.0021829905169163`*^9}, {
  4.0021954485202217`*^9, 
  4.0021954489782143`*^9}},ExpressionUUID->"8cb39cc9-374c-714e-aa39-\
5be1ded510d6"],

Cell[TextData[{
 "Start with a fresh kernel and choose Evaluation -> Evaluate Notebook. All \
input cells are open. Explanations are text cells; executable cells use \
ordinary loops, arrays, and exact symbolic algebra. ",
 StyleBox["array[[k]]",
  FontFamily->"Courier"],
 " selects an entry, ",
 StyleBox["Table",
  FontFamily->"Courier"],
 " builds an array, ",
 StyleBox["/.",
  FontFamily->"Courier"],
 " substitutes a value, and ",
 StyleBox["Which",
  FontFamily->"Courier"],
 " / ",
 StyleBox["Switch",
  FontFamily->"Courier"],
 " express a list of cases. No functional-programming shorthand is used."
}], "Text",
 CellChangeTimes->{{4.002182934430832*^9, 
  4.0021829363344803`*^9}},ExpressionUUID->"6d2c65cb-f52d-7f44-a49c-\
6e42ef82f1c3"],

Cell[CellGroupData[{

Cell["1. Data from the paper", "Section",ExpressionUUID->"3fe5af90-c501-5642-bc06-53f1aaf49954"],

Cell[TextData[{
 "The corner order throughout is bottom-left, bottom-right, top-left, \
top-right. The names left, right, up, down refer to descent arrows; the \
stored vectors are gradients, so their signs are reversed. ",
 StyleBox["cornerData",
  FontFamily->"Courier"],
 " transcribes the table \"Exact interpolation data\"; ",
 StyleBox["regions",
  FontFamily->"Courier"],
 " transcribes the rectangle table. The accuracy is exactly 10^-10."
}], "Text",ExpressionUUID->"0e658cde-4e8e-0d4f-aeaa-7dfda4c8c0ee"],

Cell["\<\
seconds=30; useResolve=True;
epsG=1/10^10; epsH=1/10^10;
Clear[x,y,a,b,aa,bb,cc,dd,u,v,t];
left = {1/2, 0};
right = {-1/2, 0};
up = {0, -1/2};
down = {0, 1/2};\
\>", "Input",
 ShowCellBracket->True,
 Evaluatable->True,
 CellOpen->True,
 CellChangeTimes->{{4.002257601548151*^9, 4.0022576031658707`*^9}},
 CellTags->"Settings",
 CellLabel->
  "In[469]:=",ExpressionUUID->"548dad49-25a7-df46-b419-45576ab99a11"],

Cell["\<\
cornerData = {
  {1, {cc, dd, aa, bb}, {right, right, right, right}},
  {2, {cc, dd, aa, bb}, {up, up, right, right}},
  {3, {cc, dd, aa, bb}, {up, up, right, up}},
  {4, {cc, dd, aa, bb}, {right, up, up, up}},
  {\"A\", {a+b-1, a+b, 0, a}, {up, up, left, right}},
  {\"B\", {b-1, b, 0, a},     {up, left, up, right}},
  {\"C\", {0, a-2, a, a-1},   {left, right, down, right}},
  {\"D\", {0, a, -1, -2},     {up, right, up, up}},
  {\"E\", {0, a-1, -1, a},    {up, right, up, right}},
  {\"F\", {0, 1, a+1, a},     {left, left, right, down}},
  {\"G\", {0, a-1, -1, a},    {up, down, up, down}}
};\
\>", "Input",
 ShowCellBracket->True,
 Evaluatable->True,
 CellOpen->True,
 CellTags->"GroupData",
 CellLabel->
  "In[476]:=",ExpressionUUID->"2aa46a6d-92f7-b44f-9dc0-30443ab2bc23"],

Cell["\<\
regions = {
  {1, {0,1,0,1},                 \"Gx < -epsG\"},
  {2, {0,1,0,3/4},               \"Gy < -epsG\"},
  {2, {0,1,3/4,1},               \"Gx < -epsG\"},
  {3, {0,1/2,0,3/4},             \"Gy < -epsG\"},
  {3, {0,1/2,3/4,1},             \"Gx < -epsG\"},
  {3, {1/2,1,0,1},               \"Gy < -epsG\"},
  {4, {0,1/2,0,1/4},             \"Gx < -epsG\"},
  {4, {0,1/2,1/4,1},             \"Gy < -epsG\"},
  {4, {1/2,1,0,1},               \"Gy < -epsG\"},

  {\"A\", {0,1,0,99/100},          \"Gy < -epsG\"},
  {\"A\", {0,99/100,99/100,1},     \"Gx > epsG\"},
  {\"A\", {99/100,1,99/100,1},     \"Hxx < -epsH\"},
  {\"B\", {0,1/10,0,1},            \"Gy < -epsG\"},
  {\"B\", {1/10,9/10,0,1},         \"Gx > epsG\"},
  {\"B\", {9/10,1,0,1/10},         \"Gx > epsG\"},
  {\"B\", {9/10,1,1/10,9/10},      \"Gy > epsG\"},
  {\"B\", {9/10,1,9/10,1},         \"Hxx < -epsH\"},
  {\"C\", {0,99/100,0,1/100},      \"Gx > epsG\"},
  {\"C\", {0,99/100,1/100,1},      \"Gy > epsG\"},
  {\"C\", {99/100,1,0,1},          \"Hxx < -epsH\"},
  {\"D\", {0,1,1/100,1},           \"Gy < -epsG\"},
  {\"D\", {0,1/10,0,1/100},        \"Gy < -epsG\"},
  {\"D\", {1/10,1/2,0,1/100},      \"Gx > epsG\"},
  {\"D\", {1/2,1,0,1/100},         \"Hxx < -epsH\"},
  {\"E\", {0,1/10,0,1},            \"Gy < -epsG\"},
  {\"E\", {1/10,9/10,0,1},         \"Gx > epsG\"},
  {\"E\", {9/10,1,0,1},            \"Hxx < -epsH\"},
  {\"F\", {0,1,0,21/50},           \"Gx > epsG\"},
  {\"F\", {0,1,21/50,99/100},      \"Gy > epsG\"},
  {\"F\", {0,17/20,99/100,1},      \"Gx < -epsG\"},
  {\"F\", {17/20,1,99/100,1},      \"Gy > epsG\"},
  {\"G\", {0,1/100,0,1},           \"Gy < -epsG\"},
  {\"G\", {1/100,99/100,0,1},      \"Gx > epsG\"},
  {\"G\", {99/100,1,0,1},          \"Gy > epsG\"}
};\
\>", "Input",
 ShowCellBracket->True,
 Evaluatable->True,
 CellOpen->True,
 CellTags->"Regions",
 CellLabel->
  "In[477]:=",ExpressionUUID->"5cb101e5-3784-dd4e-bbac-44c6447e4925"]
}, Open  ]],

Cell[CellGroupData[{

Cell["2. Verify the SOSP exclusion criteria", "Section",ExpressionUUID->"9e36adf8-f135-1349-a89b-107b6556d590"],

Cell["\<\
Reconstruct the paper's biquintic polynomial from the corner values, \
gradients, and common corner Hessian. For Groups 1-4, sigma=t-1/2 with \
0<=t<=1; for A-G, sigma=-1/2. Differentiate to obtain Gx, Gy, and Hxx. Each \
assigned rectangle uses exactly the signed gradient or negative-curvature \
inequality stated in the paper.\
\>", "Text",ExpressionUUID->"08856e4e-3bfb-c141-bb94-12775e4ac061"],

Cell["\<\
hx = 6*x^5 - 15*x^4 + 10*x^3;
hy = 6*y^5 - 15*y^4 + 10*y^3;
w0x = x - 6*x^3 + 8*x^4 - 3*x^5;
w1x = -4*x^3 + 7*x^4 - 3*x^5;
w0y = y - 6*y^3 + 8*y^4 - 3*y^5;
w1y = -4*y^3 + 7*y^4 - 3*y^5;
valueBasis = {(1-hx)*(1-hy), hx*(1-hy), (1-hx)*hy, hx*hy};
xBasis = {w0x*(1-hy), w1x*(1-hy), w0x*hy, w1x*hy};
yBasis = {(1-hx)*w0y, hx*w0y, (1-hx)*w1y, hx*w1y};\
\>", "Input",
 ShowCellBracket->True,
 Evaluatable->True,
 CellOpen->True,
 CellTags->"InterpolationBasis",
 CellLabel->
  "In[478]:=",ExpressionUUID->"15dce28a-cc7e-d94e-a4c6-02630c59016b"],

Cell[CellGroupData[{

Cell["The affine coefficient test", "Subsection",ExpressionUUID->"d34ff8f9-4ae7-1e46-b62c-460331695d0a"],

Cell["\<\
The nonnegative variables u and v denote the excess above the paper's lower \
bounds on corner differences or color gaps. For Group B, use a=9995*10^9+u \
and b/a=(1-t)(99/10000)+t(101/9995). At each required endpoint t=0,1, the \
signed margin must have the identity p=p0+u*pu+v*pv, with p0, pu, pv rational \
polynomials in x,y. Check p0>0, pu>=0, pv>=0 on the assigned rectangle. \
Affine dependence in t covers the interval. These are precisely the paper's \
coefficient conditions, including the rectangle edges.\
\>", "Text",
 CellChangeTimes->{
  4.0022569872051945`*^9},ExpressionUUID->"1a22620e-a6e0-a146-bd90-\
d1bc1fad3f46"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Two exact checks of the same inequalities", "Subsection",ExpressionUUID->"d2bb261a-ae5a-fb4c-8fce-02f464bb8bda"],

Cell[TextData[{
 "The main loop places the optional ",
 StyleBox["Resolve",
  FontFamily->"Courier"],
 " call and the Bernstein alternative next to each other. Set ",
 StyleBox["useResolve=True",
  FontFamily->"Courier"],
 " to run both. Each call has a time limit given by ",
 StyleBox["seconds",
  FontFamily->"Courier"],
 "; an unevaluated or timed-out result does not certify an inequality. The \
default uses Bernstein coefficients only, without changing the polynomial \
conditions being tested."
}], "Text",ExpressionUUID->"57dcdd7a-aab6-ed48-9c43-c46d64c745a7"],

Cell["\<\
For the Bernstein check, map a rectangle to [0,1]^2 and write q(s,t)=sum \
c[k,l] s^k t^l with degrees m,n. Its Bernstein coefficient at (i,j) is \
sum[k<=i,l<=j] c[k,l] binomial(i,k) binomial(j,l)/(binomial(m,k) \
binomial(n,l)). The Bernstein basis is nonnegative and sums to one, so the \
least coefficient is a rigorous lower bound, including the boundary. A \
positive lower bound certifies p0>0; nonnegative lower bounds certify \
pu,pv>=0. No floating-point arithmetic is used.\
\>", "Text",ExpressionUUID->"f7f9ce92-6a56-5a48-b891-db30ae1c2099"],

Cell["\<\
The coverage check verifies that the certified closed rectangles lie in the \
unit square, have disjoint interiors, and have total area one. Their union \
therefore covers the square. The separate constrained-boundary argument \
remains the one in the paper.\
\>", "Text",ExpressionUUID->"2807b0ac-9a27-3d4a-839e-6cd4a9f8c2cc"],

Cell["\<\
rationalPolynomialQ[poly_] := Module[{c, i, j, ok = True},
  If[!PolynomialQ[poly, {x, y}], Return[False]];
  c = CoefficientList[poly, {x, y}];
  For[i = 1, i <= Length[c], i++,
    For[j = 1, j <= Length[c[[i]]], j++,
      If[!IntegerQ[c[[i,j]]] && Head[c[[i,j]]] =!= Rational, ok = False]]];
  ok
];

bernsteinMinimum[poly_, box_] := Module[{s, t, q, c, m, n, i, j, k, l, b, \
lower},
  q = Expand[poly /. {x -> box[[1]] + (box[[2]]-box[[1]]) s,
                     y -> box[[3]] + (box[[4]]-box[[3]]) t}];
  If[q === 0, Return[0]];
  c = CoefficientList[q, {s, t}];
  m = Length[c]-1; n = Length[c[[1]]]-1; lower = Infinity;
  For[i = 0, i <= m, i++,
    For[j = 0, j <= n, j++,
      b = 0;
      For[k = 0, k <= i, k++,
        For[l = 0, l <= j, l++,
          b += c[[k+1,l+1]] Binomial[i,k] Binomial[j,l]/
                 (Binomial[m,k] Binomial[n,l])]];
      lower = Min[lower, b]]];
  lower
];

partitionQ[boxes_] := Module[{area = 0, i, j, u, v, ok = True},
  If[Length[boxes] == 0, Return[False]];
  For[i = 1, i <= Length[boxes], i++,
    u = boxes[[i]];
    If[!TrueQ[0 <= u[[1]] < u[[2]] <= 1 && 0 <= u[[3]] < u[[4]] <= 1],
      ok = False];
    area += (u[[2]]-u[[1]]) (u[[4]]-u[[3]]);
    For[j = 1, j < i, j++,
      v = boxes[[j]];
      If[Min[u[[2]],v[[2]]] > Max[u[[1]],v[[1]]] &&
         Min[u[[4]],v[[4]]] > Max[u[[3]],v[[3]]], ok = False]]];
  ok && area == 1
];
\
\>", "Input",
 ShowCellBracket->True,
 Evaluatable->True,
 CellOpen->True,
 CellTags->"PolynomialHelpers",
 CellLabel->
  "In[487]:=",ExpressionUUID->"37f9471c-cbc1-d240-9062-884532bbf0f8"],

Cell[CellGroupData[{

Cell["\<\
results = {}; bernsteinBounds = {}; summary = {}; allPassed = True;
For[groupIndex = 1, groupIndex <= Length[cornerData], groupIndex++,
  group = cornerData[[groupIndex,1]];
  values = cornerData[[groupIndex,2]]; gradients = cornerData[[groupIndex,3]];
  sigma = -1/2;
  If[IntegerQ[group], sigma = t-1/2];
  f = sigma/2 (x^2 (1-x)^2 + y^2 (1-y)^2);
  For[k = 1, k <= 4, k++,
    f += values[[k]] valueBasis[[k]] + gradients[[k,1]] xBasis[[k]] +
         gradients[[k,2]] yBasis[[k]]];
  gx = D[f,x]; gy = D[f,y]; hxx = D[f,{x,2}];
  provedRectangles = {}; total = 0; resolvePassed = 0; bernsteinPassed = 0;
  For[rowIndex = 1, rowIndex <= Length[regions], rowIndex++,
    row = regions[[rowIndex]];
    If[row[[1]] =!= group, Continue[]];
    rectangle = row[[2]]; name = row[[3]]; total++;
    p = Switch[name, \"Gx > epsG\", gx-epsG, \"Gx < -epsG\", -gx-epsG,
      \"Gy > epsG\", gy-epsG, \"Gy < -epsG\", -gy-epsG, \"Hxx < -epsH\", \
-hxx-epsH];
    rules = {a -> 10^20+u};
    If[group == \"A\", rules = {a -> 10^40+u, b -> 10^40+v}];
    If[group == \"B\", rules = {a -> 9995*10^9+u,
      b -> (9995*10^9+u) (99/10000+t (101/9995-99/10000))}];
    If[IntegerQ[group],
      rules = {cc -> aa+1+u, dd -> bb+1+v};
      If[name == \"Gx < -epsG\",
        bottom = 1; top = 1;
        If[group == 2 || group == 3, bottom = -1];
        If[group == 4, top = -1];
        rules = {cc -> dd+bottom+u, aa -> bb+top+v}]];
    p = Expand[p /. rules];
    domain = rectangle[[1]] <= x <= rectangle[[2]] && rectangle[[3]] <= y <= \
rectangle[[4]];
    validForm = PolynomialQ[p,{x,y,u,v,t}] && Expand[D[p,{t,2}]] === 0;
    conditions = True; triples = {}; endpoints = {0};
    If[!FreeQ[p,t], endpoints = {0,1}];
    For[e = 1, e <= Length[endpoints], e++,
      endpoint = Expand[p /. t -> endpoints[[e]]];
      p0 = Expand[endpoint /. {u -> 0, v -> 0}];
      pu = Coefficient[endpoint,u]; pv = Coefficient[endpoint,v];
      validForm = validForm && rationalPolynomialQ[p0] &&
        rationalPolynomialQ[pu] && rationalPolynomialQ[pv] &&
        Expand[endpoint-p0-u pu-v pv] === 0;
      conditions = conditions && p0 > 0 && pu >= 0 && pv >= 0;
      AppendTo[triples,{p0,pu,pv}]];

    answer = Missing[\"Skipped\"];
    If[useResolve && TrueQ[validForm],
      statement = ForAll[{x,y},Evaluate[Implies[domain,conditions]]];
      answer = TimeConstrained[Resolve[statement,Reals],seconds,$Aborted]];
    bernsteinAnswer = False;
    If[TrueQ[validForm],
      bernsteinAnswer = TimeConstrained[
        boundPassed = True;
        For[e = 1, e <= Length[triples], e++,
          lower = {0,0,0};
          For[k = 1, k <= 3, k++,
            lower[[k]] = bernsteinMinimum[triples[[e,k]],rectangle]];
          AppendTo[bernsteinBounds,{group,rectangle,name,lower}];
          If[!TrueQ[lower[[1]] > 0 && lower[[2]] >= 0 && lower[[3]] >= 0],
            boundPassed = False]];
        boundPassed, seconds, $Aborted]];
    AppendTo[results,{group,rectangle,name,answer,bernsteinAnswer}];
    If[TrueQ[answer], resolvePassed++];
    If[TrueQ[bernsteinAnswer], bernsteinPassed++];
    If[TrueQ[answer] || TrueQ[bernsteinAnswer], \
AppendTo[provedRectangles,rectangle]]
  ];
  coverage = partitionQ[provedRectangles]; allPassed = allPassed && \
TrueQ[coverage];
  AppendTo[summary,{group,resolvePassed,bernsteinPassed,total,coverage}];
  Print[\"Group \",group,\": square covered = \",coverage]
];
Print[Grid[Prepend[summary,
  {\"Group\",\"Resolve\",\"Bernstein\",\"Rectangles\",\"Square \
covered\"}],Frame -> All]];
Print[\"All polynomial groups verified: \",allPassed];
\
\>", "Input",
 ShowCellBracket->True,
 Evaluatable->True,
 CellOpen->True,
 CellTags->"PolynomialChecks",
 CellLabel->
  "In[493]:=",ExpressionUUID->"d9ac62f4-d805-8d49-bb91-8b83ac313323"],

