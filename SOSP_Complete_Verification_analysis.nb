Cell[CellGroupData[{

Cell["Scope", "Section",ExpressionUUID->"a2070f9d-f503-314f-88d7-584840ae5e7e"],

Cell["\<\
The notebook verifies the local polynomial inequalities and the paper's \
selected classification. The paper supplies the interpolation, \
finite-coverage, transformation, and constrained-boundary arguments. Exact \
simulation reproduces the 57 original output rows, and all 54 prescribed \
non-X certificates are checked. \
\>", "Text",
 CellChangeTimes->{
  4.002195644079178*^9},ExpressionUUID->"7580adfe-6c3c-6e4e-b842-\
8ea99e55c34f"]
}, Open  ]]
}, Open  ]]
