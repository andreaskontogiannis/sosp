Cell[CellGroupData[{

Cell["\<\
colorNames = {\"blue\",\"black\",\"red\",\"green\",\"orange\"};
arrowNames = {\"left\",\"right\",\"up\",\"down\"};
indexOf[name_, names_] := Module[{i, found = 0},
  For[i = 1, i <= Length[names], i++,
    If[name === names[[i]], found = i]];
  found
];

classificationPassed = enumerationPassed && symmetryPassed;
report = {{\"Case\",\"BL\",\"BR\",\"TL\",\"TR\",\"Transformation\",\"Sign\",\"\
Verified\"}};
listed = {};
For[k = 1, k <= Length[paperCases], k++,
  entry = paperCases[[k]];
  case = entry[[1]]; group = entry[[3]]; sign = entry[[5]];
  h = indexOf[entry[[4]],symmetryNames];
  pattern = {};
  For[l = 1, l <= 4, l++,
    pair = StringSplit[entry[[2,l]],\"-\"];
    codes = {0,0};
    If[Length[pair] == 2,
      codes = {indexOf[pair[[1]],colorNames],indexOf[pair[[2]],arrowNames]}];
    AppendTo[pattern,codes]];
  passed = h > 0 && MemberQ[{1,-1},sign] &&
    MemberQ[patterns,pattern] && !MemberQ[listed,pattern];
  If[passed,
    If[group == \"X\",
      passed = h == 1 && sign == 1 && MemberQ[xPatterns,pattern] &&
        !MemberQ[nonSolutionPatterns,pattern],
      groupIndex = 0;
      For[l = 1, l <= Length[cornerData], l++,
        If[cornerData[[l,1]] === group, groupIndex = l]];
      If[groupIndex == 0 || (sign == -1 && !IntegerQ[group]),
        passed = False,
        v = sign gridValues[pattern][[permutations[[h]]]];
        d = sign \
arrowVectors[[pattern[[permutations[[h]],2]]]].symmetries[[h]];
        passed = MemberQ[nonSolutionPatterns,pattern] &&
          d === -2 cornerData[[groupIndex,3]] && groupFits[groupIndex,v]]]];
  AppendTo[listed,pattern];
  row = Join[{case},entry[[2]],{entry[[4]],sign,TrueQ[passed]}];
  AppendTo[report,row];
  If[!TrueQ[passed], classificationPassed = False]
];
For[k = 1, k <= Length[patterns], k++,
  If[!MemberQ[listed,patterns[[k]]],
    classificationPassed = False; Print[\"Unlisted pattern: \
\",patterns[[k]]]]];
Print[Grid[report,Frame -> All]];
Print[\"Paper classification verified: \",classificationPassed];
completeVerificationPassed = allPassed && classificationPassed;
Print[\"Polynomial checks and paper classification verified: \
\",completeVerificationPassed];
\
\>", "Input",
 ShowCellBracket->True,
 Evaluatable->True,
 CellOpen->True,
 CellChangeTimes->{{4.0022571524578743`*^9, 4.002257164379135*^9}},
 CellTags->"ClassificationReport",
 CellLabel->
  "In[535]:=",ExpressionUUID->"a74c8ff3-75d0-0b40-a6b3-ee0ed9c1dd48"],

