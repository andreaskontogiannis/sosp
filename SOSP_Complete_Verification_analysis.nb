Cell[CellGroupData[{

Cell["3. Enumerate the cell patterns from the construction", "Section",ExpressionUUID->"0d73ba69-8863-9d45-8814-f6d281641bc4"],

Cell["\<\
This is the coverage step behind the classification figures. We retain the \
colors and all four descent arrows before applying any transformations. In \
particular, the enumeration is independent of the group matching: an \
unclassified pattern cannot be silently discarded.\
\>", "Text",
 CellChangeTimes->{
  4.002256969192219*^9},ExpressionUUID->"bfa806ee-7e51-3945-a021-\
10ea694de94f"],

Cell[CellGroupData[{

Cell["Why a finite enumeration covers every input size", "Subsection",ExpressionUUID->"1cd21b28-2e40-3c4b-98e1-ce7aba72dd8a"],

Cell["\<\
Let M be the actual number of circuit nodes and N=6M+6. Write a cell's \
lower-left corner as (6i+r,6j+s), where 0<=i,j<=M and r,s in {0,...,5}. \
Inspecting the piecewise formulas shows that only columns i,i+1 and corridor \
row j can affect its four corners. A valid node has state 0 if C(k)=k, state \
1 if it is an ITER solution, and state 2 if C(k)>k and C(C(k))!=C(k). For a \
row in state 2, retain its endpoint e=C(j)>j; that endpoint is not fixed.\
\>", "Text",ExpressionUUID->"bdcc1be3-1511-5941-8bc8-98eeccf6af42"],

Cell["\<\
After the residues are fixed, the formulas depend only on these states and \
the order/equalities of 0,1,i,i+1,j,e,M,M+1. There are at most six distinct \
labels inside [1,M]. Relabel them in [1,6], keeping 1 and M as endpoints and \
keeping i,i+1 consecutive when both lie inside. Spare labels can be inserted \
in another gap; the only obstruction would be M=2 with i=1, excluded by the \
large-size assumption. Relabel 0 and M+1 as 0 and 7. Every actual cell is \
therefore represented by the finite enumeration below; the choice six is an \
order abstraction, not a test of one small circuit.\
\>", "Text",ExpressionUUID->"698f416c-ee4e-3340-97b0-8e96087e2aad"],

Cell["\<\
Repeated indices must receive the same state; exterior indices have state 0. \
Since C(1)>1, node 1 is not fixed, and the last node cannot be continuing. A \
queried corridor endpoint must be active. Some remaining assignments can be \
unrealizable; including them is safe because every retained pattern must \
still be certified. The later value checks use the actual symbolic N, not the \
size of this finite abstraction.\
\>", "Text",ExpressionUUID->"ba892d75-78d4-dc43-b036-7b25e65b8cdf"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Translate the piecewise formulas", "Subsection",ExpressionUUID->"b47d431a-a177-4e49-8049-0277f653a7eb"],

Cell[TextData[{
 "Colors 1,...,5 mean blue, black, red, green, orange. Arrow codes 1,...,4 \
mean left, right, up, down. ",
 StyleBox["cellTests",
  FontFamily->"Courier"],
 " follows the blue, black, green, orange and arrow clauses of the paper; red \
and right are defaults. The seven returned conditions are evaluated before ",
 StyleBox["pointFromTests",
  FontFamily->"Courier"],
 " selects the first applicable case, preserving the priority of the \
piecewise definition."
}], "Text",
 CellChangeTimes->{
  4.002256960158083*^9},ExpressionUUID->"e87586e4-b596-b046-967b-\
c444725ad6ae"],

Cell["\<\
Clear[state, end];
smallSize = 6;
node[k_] := 1 <= k <= smallSize;
active[k_] := node[k] && state[k] != 0;
solution[k_] := node[k] && state[k] == 1;
continuing[k_] := node[k] && state[k] == 2;
corners = {{0, 0}, {1, 0}, {0, 1}, {1, 1}};
arrowVectors = {{-1, 0}, {1, 0}, {0, 1}, {0, -1}};

cellTests[x_, y_, i_, j_] := Module[
  {edge = 6 smallSize + 6, k, blue, black, green, orange,
   upward, leftward, downward},
  blue = False;
  black = edge - 4 <= x <= edge - 2 && y == 2;
  green = (2 <= x <= edge && 0 <= y <= 1) ||
    (edge - 1 <= x <= edge && 2 <= y <= edge - 2);
  orange = (0 <= x <= 1 && 0 <= y <= edge) ||
    (2 <= x <= edge && edge - 1 <= y <= edge);
  upward = 2 <= x <= edge && 0 <= y <= 1;
  leftward = black || (edge - 1 <= x <= edge && 2 <= y <= edge - 2);
  downward = (2 <= x <= edge && edge - 1 <= y <= edge) ||
    (x == edge - 2 && 3 <= y <= edge - 2);
  For[k = i, k <= i + 1, k++,
    blue = blue ||
      (6 k - 3 <= x <= 6 k - 1 && 3 <= y <= 6 k + 2 && active[k]) ||
      (x == 6 k - 2 && y == 2 && active[k]) ||
      (6 k <= x <= 6 k + 2 && 6 k + 1 <= y <= 6 k + 2 && continuing[k]) ||
      (6 k + 1 <= x <= 6 k + 2 && 6 j + 1 <= y <= 6 j + 2 && node[k] && \
continuing[j] && end > k > j) ||
      (6 k - 3 <= x <= 6 k + 2 && 6 j + 1 <= y <= 6 j + 2 && node[k] && \
!active[k] && continuing[j] && end > k > j);
    black = black ||
      (6 k - 1 <= x <= 6 k + 1 && y == 2 && active[k]) ||
      (6 k - 4 <= x <= 6 k + 1 && y == 2 && node[k] && !active[k]);
    upward = upward ||
      (6 k - 2 <= x <= 6 k - 1 && 2 <= y <= 6 k + 1 && active[k]) ||
      (6 k - 2 <= x <= 6 k - 1 && y == 6 k + 2 && solution[k]) ||
      (6 k <= x <= 6 k + 2 && y == 6 k + 1 && continuing[k]) ||
      (6 k + 1 <= x <= 6 k + 2 && y == 6 j + 1 && node[k] && continuing[j] && \
end > k > j) ||
      (6 k - 3 <= x <= 6 k + 2 && y == 6 j + 1 && node[k] && !active[k] && \
continuing[j] && end > k > j) ||
      (x == 6 k - 3 && y == 6 j + 1 && active[k] && continuing[j] && end >= k \
> j);
    leftward = leftward ||
      (6 k <= x <= 6 k + 1 && y == 2 && active[k]) ||
      (6 k - 4 <= x <= 6 k + 1 && y == 2 && node[k] && !active[k]);
    downward = downward ||
      (6 k - 2 <= x <= 6 k - 1 && 6 k + 3 <= y <= edge - 2 && solution[k]) ||
      (x == 6 k - 5 && y == 3 && k > 1 && active[k]);
  ];
  {blue, black, green, orange, upward, leftward, downward}
];

pointFromTests[z_] := {
  Which[z[[1]], 1, z[[2]], 2, z[[3]], 4, z[[4]], 5, True, 3],
  Which[z[[5]], 3, z[[6]], 1, z[[7]], 4, True, 2]
};
\
\>", "Input",
 ShowCellBracket->True,
 Evaluatable->True,
 CellOpen->True,
 CellTags->"GeometryDefinitions",
 CellLabel->
  "In[498]:=",ExpressionUUID->"e28dc309-2c5a-f34c-86e4-51422aecd301"]
}, Open  ]],

Cell[CellGroupData[{

Cell["List every pattern and locate X", "Subsection",ExpressionUUID->"3653d27c-2dcb-224d-8bbb-4fd90486e89e"],

Cell[TextData[{
 "For each pair i,j, build the 7 x 7 array of conditions once. Substitute \
every consistent choice of the three node states and the corridor endpoint, \
then read the 36 cells from this array. Ordinary membership tests retain \
distinct patterns. ",
 StyleBox["witnesses[[k]]",
  FontFamily->"Courier"],
 " stores a first abstract occurrence of ",
 StyleBox["patterns[[k]]",
  FontFamily->"Courier"],
 " as {i,j,r,s,{state(i),state(i+1),state(j)},e}. It is an audit record of \
the enumeration, not a claimed circuit realization."
}], "Text",ExpressionUUID->"d13b35ab-bf29-6044-9e89-889dbcafd976"],

Cell["\<\
The paper's X cells are Box(6k-3,6k+2), Box(6k-2,6k+2), and Box(6k-1,6k+2), \
where k is an ITER solution. Equivalently, j=i+1, r in {3,4,5}, s=2, and \
state(i+1)=1. Record both X and non-X occurrences. The check requires that no \
X pattern also occurs outside these locations; all other patterns must pass \
the representative check.\
\>", "Text",ExpressionUUID->"34c79cda-f61c-1a4f-a9f8-b6bcd579b3bd"],

Cell[CellGroupData[{

Cell["\<\
choices = {};
For[si = 0, si <= 2, si++,
  For[sk = 0, sk <= 2, sk++,
    For[sj = 0, sj <= 2, sj++, AppendTo[choices, {si, sk, sj}]]]];
patterns = {}; nonSolutionPatterns = {}; xPatterns = {}; witnesses = {};
configurations = 0;
For[i = 0, i <= smallSize, i++,
  For[j = 0, j <= smallSize, j++,
    keys = {i, i+1, j};
    template = Table[cellTests[6 i+r, 6 j+s, i, j], {r,0,6}, {s,0,6}];
    For[c = 1, c <= Length[choices], c++,
      status = ConstantArray[-1, smallSize+2];
      status[[1]] = 0; status[[smallSize+2]] = 0; valid = True;
      For[k = 1, k <= 3, k++,
        index = keys[[k]]+1;
        If[status[[index]] != -1 && status[[index]] != choices[[c,k]], valid \
= False];
        status[[index]] = choices[[c,k]]];
      If[status[[2]] == 0 || status[[smallSize+1]] == 2, valid = False];
      If[!valid, Continue[]];
      stateRules = Table[state[k] -> status[[k+1]], {k,0,smallSize+1}];
      ends = {0};
      If[status[[j+1]] == 2, ends = Range[j+1,smallSize]];
      For[e = 1, e <= Length[ends], e++,
        endpoint = ends[[e]];
        If[endpoint > 0 && status[[endpoint+1]] == 0, Continue[]];
        configurations++;
        tests = template /. Join[stateRules, {end -> endpoint}];
        grid = Table[pointFromTests[tests[[r,s]]], {r,1,7}, {s,1,7}];
        For[r = 0, r <= 5, r++,
          For[s = 0, s <= 5, s++,
            pattern = {grid[[r+1,s+1]], grid[[r+2,s+1]],
                       grid[[r+1,s+2]], grid[[r+2,s+2]]};
            isX = j == i+1 && r >= 3 && s == 2 && status[[i+2]] == 1;
            If[!MemberQ[patterns,pattern],
              AppendTo[patterns,pattern];
              AppendTo[witnesses,{i,j,r,s,choices[[c]],endpoint}]];
            If[isX,
              If[!MemberQ[xPatterns,pattern], AppendTo[xPatterns,pattern]],
              If[!MemberQ[nonSolutionPatterns,pattern], \
AppendTo[nonSolutionPatterns,pattern]]]
          ]]
      ]
    ]
  ];
  Print[\"Completed column index \",i,\" of \",smallSize]
];
enumerationPassed = configurations == 865 && Length[patterns] == 57 &&
  Length[nonSolutionPatterns] == 54 && Length[xPatterns] == 3;
For[k = 1, k <= Length[xPatterns], k++,
  If[MemberQ[nonSolutionPatterns,xPatterns[[k]]], enumerationPassed = False]];
Print[configurations,\" configurations; \",Length[patterns],\" patterns; \",
      Length[xPatterns],\" patterns confined to X cells.\"];
\
\>", "Input",
 ShowCellBracket->True,
 Evaluatable->True,
 CellOpen->True,
 CellTags->"FiniteEnumeration",
 CellLabel->
  "In[511]:=",ExpressionUUID->"c67ba404-ddd7-7949-970a-7efd76314e41"],

